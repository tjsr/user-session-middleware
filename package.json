{
  "name": "@tjsr/user-session-middleware",
  "version": "0.2.2",
  "description": "User session handling middleware and utilities",
  "type": "module",
  "main": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "prebuild:dev": "linkteam -i",
    "build:dev": "tsc -w",
    "build:dist": "rimraf dist && tsc -p tsconfig.publish.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.cjs",
    "check": "npx npm-check",
    "clean": "npx rimraf build dist coverage",
    "clean:all": "npx rimraf build dist coverage node_modules",
    "link": "linkteam -i",
    "lint": "eslint --config eslint.config.mjs src/*.ts",
    "lint:fix": "eslint --fix src/*.ts",
    "prepack": "npm test && npm run build:dist && node scripts/test-package.cjs",
    "prepublishOnly": "npm run clean",
    "test": "vitest --run && npm run lint",
    "test:first": "vitest --run --bail=1 && npm run lint",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run build:dist && node scripts/test-package.cjs"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "package.json"
    ],
    "ext": "ts",
    "ignore": "dist",
    "exec": "tsc -p tsconfig.publish.json && tsc -p tsconfig.cjs.json",
    "delay": 200
  },
  "test": "foobar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjsr/user-session-middleware.git"
  },
  "keywords": [
    "Express",
    "Session"
  ],
  "author": "Tim Rowe <tim@tjsr.id.au>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tjsr/user-session-middleware/issues"
  },
  "homepage": "https://github.com/tjsr/user-session-middleware#readme",
  "devDependencies": {
    "@tjsr/eslint-config": "github:tjsr/eslint-config#main",
    "@tjsr/testutils": "^0.0.12",
    "@types/cookie": "^0.6.0",
    "@types/cookie-signature": "^1.1.2",
    "@types/node": "^24.19.2",
    "@types/request-ip": "^0.0.41",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "expect-cookies": "^0.3.1",
    "linkteam": "^0.0.18",
    "prettier-plugin-sort-members": "^0.2.5",
    "rimraf": "^6.1.3",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vitest-mock-express": "^2.2.0",
    "express": "5.3.0"
  },
  "dependencies": {
    "@tjsr/mysql-pool-utils": "^0.2.2",
    "@tjsr/simple-env-utils": "^0.1.11",
    "cookie": "^2.0.1",
    "cookie-signature": "^1.2.2",
    "email-validator": "^2.0.4",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "snowflake-uuid": "^1.0.0",
    "uuid": "^14.0.3",
    "@types/express": "5.0.6",
    "@types/express-mysql-session": "file:vendor/express-mysql-session-types-3.0.8-mysql2-3.10.2.tgz",
    "@types/express-session": "^1.19.0"
  },
  "peerDependencies": {
    "express": "^5.3.0"
  },
  "overrides": {
    "braces": ">=3.0.3",
    "glob": ">=11.0.0",
    "rimraf@<=4": "$rimraf",
    "vitest-mock-express": {
      "@types/express": "$@types/express"
    },
    "mysql2@<3.10.0": ">=3.10.0 <4"
  },
  "optionalDependencies": {
    "nodemon": "^3.1.14"
  },
  "eslintConfig": {
    "extends": [
      "@tjsr/eslint-config"
    ]
  },
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=12.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.27.1": true
  },
  "files": [
    "dist",
    "vendor"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bundledDependencies": [
    "@types/express-mysql-session"
  ]
}
